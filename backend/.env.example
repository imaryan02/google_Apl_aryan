# AI Stadium Command Center Backend Configuration

# Database Connection:
# ----------------------------------------------------
# For local SQLite offline fallback (Default):
# DATABASE_URL=sqlite:///./stadium.db
#
# For Supabase (PostgreSQL URI):
# Go to your Supabase Dashboard -> Project Settings -> Database -> Connection String -> URI.
# Copy the URI, paste it below, and replace [YOUR-PASSWORD] with your database password.
# (Note: The server auto-normalizes "postgres://" to "postgresql://" for SQLAlchemy compatibility)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-REF-ID].supabase.co:5432/postgres

# FastAPI Server Host & Port Configurations (Optional):
# ----------------------------------------------------
HOST=127.0.0.1
PORT=8000
